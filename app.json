{
  "expo": {
    "name": "slate",
    "slug": "slate",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "slate",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lkleinbrodt.slate",
      "appleTeamId": "DU26G2LJFP",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.lkleinbrodt.slate"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Slate",
        "NSMicrophoneUsageDescription": "Slate uses the microphone when you plan your day by voice.",
        "NSCameraUsageDescription": "Slate doesn't use the camera; the voice call library asks for this permission.",
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4EEE3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F4EEE3",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#181A1E"
          }
        }
      ],
      "@bacons/apple-targets",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Slate reads your calendar to plan your day, and adds the blocks you agree to.",
          "remindersPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "42a18f63-399c-4610-a82d-bf4e08dc83a3"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/42a18f63-399c-4610-a82d-bf4e08dc83a3",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
